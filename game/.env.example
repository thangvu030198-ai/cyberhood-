# Mỗi môi trường (dev / staging / production) build với bộ biến riêng. Trống = tính năng tắt, game vẫn chạy.
VITE_GAME_VERSION=1.0.0
# Platform API (tài khoản, kho đồ, bản lưu): GET/PUT /v1/me/save với Authorization: Bearer <JWT>
VITE_API_BASE=https://api.cyberhood.xyz
# Server realtime Hub (server/ tham chiếu, hoặc Colyseus/Nakama cùng giao thức)
VITE_WS_URL=wss://rt.cyberhood.xyz
# CDN có version: manifest { current, minSupported, cdn } và remote config (game_config.json + flags)
VITE_MANIFEST_URL=https://cdn.cyberhood.xyz/game/manifest.json
VITE_CONFIG_URL=https://cdn.cyberhood.xyz/game/game_config.json
# Website được nhúng game bằng iframe (postMessage chỉ nhận / gửi với các origin này)
VITE_ALLOWED_ORIGINS=https://cyberhood.xyz,https://www.cyberhood.xyz
